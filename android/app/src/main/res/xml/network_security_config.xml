<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Mencegah cleartext HTTP di seluruh aplikasi -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Hanya mempercayai sertifikat root resmi sistem Android.
                 Sertifikat CA pengguna (User-installed CA dari Burp Suite/Charles Proxy/mitmproxy)
                 otomatis ditolak untuk mencegah inspeksi payload MitM. -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Konfigurasi domain khusus velora.co.id dengan Cloudflare SPKI Pinning -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">velora.co.id</domain>
        <!-- SPKI Pinning untuk Root CAs resmi penerbit sertifikat Cloudflare Edge.
             Pinning pada level Root CA (bukan leaf) menjamin rotasi sertifikat 90 harian
             Cloudflare tidak akan memutuskan koneksi POS kasir di lapangan.
             Atribut expiration memastikan fallback aman ke system trust setelah 2027. -->
        <pin-set expiration="2027-12-31">
            <!-- Google Trust Services Root R1 (GTS Root R1 - Primary Cloudflare Edge CA) -->
            <pin digest="SHA-256">hxqRlPTuQjvW/P31ipWfYMe++bjYhIRb3ugCzRnCh3g=</pin>
            <!-- ISRG Root X1 (Let's Encrypt - Secondary Cloudflare Edge CA) -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcRtPbsQtWLABXhQzejna0wHFr8M=</pin>
            <!-- DigiCert Global Root G2 (Cloudflare Backup Edge CA) -->
            <pin digest="SHA-256">i7WTqTvh0OioIruIfFR4kRrhULVEwL+gu9o3D1ootAU=</pin>
            <!-- DigiCert Global Root CA (Cloudflare Enterprise Root) -->
            <pin digest="SHA-256">r/mIkG3eEpVdm+u/ko/cwxzOMo1bk4TyHIlByIBb4MQ=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
